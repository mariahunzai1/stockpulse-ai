# StockPulse AI — Environment Configuration Template
STOCKPULSE_ENV=development
STOCKPULSE_RAW_DATA_DIR=data/raw
STOCKPULSE_PROCESSED_DATA_DIR=data/processed
STOCKPULSE_DUCKDB_PATH=data/stockpulse.duckdb
STOCKPULSE_FORECAST_HORIZON_DAYS=28
STOCKPULSE_HISTORY_DAYS=730
STOCKPULSE_RANDOM_SEED=42

# FastAPI Backend & Streamlit Client
STOCKPULSE_API_HOST=127.0.0.1
STOCKPULSE_API_PORT=8000
STOCKPULSE_API_BASE_URL=http://127.0.0.1:8000

# Dual OpenAI-Compatible LLM Endpoint (offline deterministic fallback runs if key is blank)
# Option A — Local Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2:3b
# Option B — Google AI Studio (OpenAI-compatible):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=your_google_ai_studio_key
#   LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
